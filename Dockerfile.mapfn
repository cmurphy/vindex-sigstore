FROM --platform=$BUILDPLATFORM golang:1.27.1-trixie@sha256:8f58fd67ea075142d947a60e0caa4317746a55118d312f027793d382c7741734 AS builder
ARG MAPFN_TYPE=hashedrekord
ENV APP_ROOT=/opt/app-root
ENV GOPATH=$APP_ROOT

WORKDIR $APP_ROOT/src/
ADD go.mod go.sum* tools.go $APP_ROOT/src/
RUN go mod download

ADD ./mapfn/ $APP_ROOT/src/mapfn/
ADD ./pkg/ $APP_ROOT/src/pkg/

# Build Rekor Identity Monitor MapFn WASM plugin reproducibly ("hashedrekord" or "identity")
RUN GOOS=wasip1 GOARCH=wasm CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="-buildid=" -buildmode=c-shared -o mapper.wasm ./mapfn/${MAPFN_TYPE}

# Scratch export stage containing only mapper.wasm for fast `docker buildx build --output type=local`
FROM scratch AS artifact
COPY --from=builder /opt/app-root/src/mapper.wasm /mapper.wasm

# Package mapper.wasm at /mapper.wasm so:
# 1. Kubernetes 1.33+ OCI image volumes mounted at /etc/vindex expose /etc/vindex/mapper.wasm directly.
# 2. Docker Compose or Kubernetes initContainers can execute the container as nonroot (65532:65532)
#    to copy /mapper.wasm into a shared /etc/vindex volume.
FROM debian:trixie-slim
RUN mkdir -p /etc/vindex && chown 65532:65532 /etc/vindex
COPY --from=builder --chown=65532:65532 /opt/app-root/src/mapper.wasm /mapper.wasm
USER 65532:65532
CMD ["cp", "-f", "/mapper.wasm", "/etc/vindex/mapper.wasm"]
